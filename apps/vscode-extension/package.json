{
  "name": "@mockflow/vscode-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:mockflow.signIn",
    "onCommand:mockflow.signOut",
    "onCommand:mockflow.selectProject",
    "onView:mockflow.projects"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mockflow",
          "title": "MockFlow",
          "icon": "$(network)"
        }
      ]
    },
    "views": {
      "mockflow": [
        {
          "id": "mockflow.projects",
          "name": "Projects"
        },
        {
          "id": "mockflow.discovery",
          "name": "API Discovery"
        }
      ]
    },
    "commands": [
      {
        "command": "mockflow.signIn",
        "title": "MockFlow: Sign In"
      },
      {
        "command": "mockflow.signOut",
        "title": "MockFlow: Sign Out"
      },
      {
        "command": "mockflow.selectProject",
        "title": "MockFlow: Select Project"
      },
      {
        "command": "mockflow.refresh",
        "title": "MockFlow: Refresh"
      },
      {
        "command": "mockflow.scanWorkspace",
        "title": "MockFlow: Scan Workspace for APIs"
      },
      {
        "command": "mockflow.reviewDiscovery",
        "title": "MockFlow: Review Discovery"
      },
      {
        "command": "mockflow.ignoreDiscovery",
        "title": "MockFlow: Ignore Discovery"
      },
      {
        "command": "mockflow.configureApi",
        "title": "MockFlow: Edit Endpoint & Scenarios"
      },
      {
        "command": "mockflow.publishApi",
        "title": "MockFlow: Publish Endpoint"
      },
      {
        "command": "mockflow.unpublishApi",
        "title": "MockFlow: Unpublish Endpoint"
      },
      {
        "command": "mockflow.copyEndpointUrl",
        "title": "MockFlow: Copy Hosted URL"
      },
      {
        "command": "mockflow.testEndpoint",
        "title": "MockFlow: Test Published Endpoint"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "mockflow.configureApi",
          "when": "view == mockflow.projects && viewItem =~ /^mockflow\\.api/"
        },
        {
          "command": "mockflow.publishApi",
          "when": "view == mockflow.projects && viewItem == mockflow.api.draft"
        },
        {
          "command": "mockflow.unpublishApi",
          "when": "view == mockflow.projects && viewItem == mockflow.api.published"
        },
        {
          "command": "mockflow.copyEndpointUrl",
          "when": "view == mockflow.projects && viewItem =~ /^mockflow\\.api/"
        },
        {
          "command": "mockflow.testEndpoint",
          "when": "view == mockflow.projects && viewItem == mockflow.api.published"
        },
        {
          "command": "mockflow.reviewDiscovery",
          "when": "view == mockflow.discovery && viewItem == mockflow.discovery"
        },
        {
          "command": "mockflow.ignoreDiscovery",
          "when": "view == mockflow.discovery && viewItem == mockflow.discovery"
        }
      ]
    },
    "configuration": {
      "title": "MockFlow",
      "properties": {
        "mockflow.controlApiBaseUrl": {
          "type": "string",
          "default": "http://localhost:4000",
          "description": "Base URL for the MockFlow control-plane API."
        },
        "mockflow.runtimeBaseUrl": {
          "type": "string",
          "default": "http://localhost:4001",
          "description": "Base URL for the MockFlow public mock runtime."
        }
      }
    }
  },
  "scripts": {
    "build": "bun build ./src/extension.ts --outdir ./dist --target node --external vscode --sourcemap",
    "dev": "bun build --watch ./src/extension.ts --outdir ./dist --target node --external vscode --sourcemap",
    "lint": "tsc -p tsconfig.json --noEmit",
    "package:vsix": "bun run build && node ./scripts/package-vsix.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mockflow/api-discovery": "workspace:*",
    "@mockflow/contracts": "workspace:*"
  }
}
