{
  "name": "@mockflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mockflow/config": "workspace:*",
    "@mockflow/contracts": "workspace:*",
    "@fastify/jwt": "^9.1.0",
    "drizzle-orm": "^0.41.0",
    "fastify": "^5.3.2",
    "postgres": "^3.4.5",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
