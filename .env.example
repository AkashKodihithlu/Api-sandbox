NODE_ENV=development
DATABASE_URL=postgresql://mockflow:mockflow_local_password@localhost:5432/mockflow
CONTROL_API_PORT=4000
RUNTIME_PORT=4001
WEB_PORT=3000
CONTROL_API_BASE_URL=http://localhost:4000
RUNTIME_BASE_URL=http://localhost:4001
AUTH_SECRET=replace-with-a-long-random-development-secret
LOG_LEVEL=debug
REQUEST_BODY_MAX_BYTES=1048576
RESPONSE_BODY_MAX_BYTES=1048576
MAX_ARTIFICIAL_DELAY_MS=10000
REQUEST_LOG_RETENTION_DAYS=7
DEFAULT_PROJECT_RATE_LIMIT=60
